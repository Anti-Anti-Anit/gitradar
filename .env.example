#!/usr/bin/env bash
# 本地运行采集器时的环境变量示例（复制为 .env 后自行 source，或直接 export）
export GITHUB_TOKEN=""                 # 必填：带 repo 读权限的 Personal Access Token 或 gh auth token
export OPENAI_API_KEY=""               # 可选：配置后自动生成中文简介
export OPENAI_BASE_URL="https://api.openai.com/v1"
export AI_MODEL="gpt-4o-mini"
